{
  "manifest_version": 3,
  "name": "Catch Train",
  "version": "0.0.3",
  "description": "코레일(KTX) 조회 결과에서 체크해 둔 칸이 열리면 알리고 [예매] 까지 눌러 준다.",

  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://www.korail.com/*"],

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.korail.com/*"],
      "js": ["src/content/early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.korail.com/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/content/ktx/*.js", "src/domain/*.js"],
      "matches": ["https://www.korail.com/*"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Catch Train",
    "default_popup": "src/ui/popup.html"
  }
}
